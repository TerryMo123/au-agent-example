# Application
APP_NAME=傲基智能数据问答 Agent
APP_ENV=development
DEBUG=true

# 阿里云百炼 / Qwen（OpenAI 兼容，推荐官方地址以支持真正 SSE）
OPENAI_API_KEY=sk-your-dashscope-key
OPENAI_MODEL=qwen-max
OPENAI_ROUTER_MODEL=qwen-turbo
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_EMBEDDING_MODEL=text-embedding-v3

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=au_agent
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_TIMEOUT=30
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=60
MYSQL_MAX_EXECUTION_TIME_MS=15000

# Chroma
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION_NAME=au_internal_docs
# local=本地目录；http=远程 Chroma Server（可水平扩展 API）
VECTOR_BACKEND=local
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
CHROMA_SSL=false

# 限流（建议生产开启；优先用 Redis）
RATE_LIMIT_ENABLED=false
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_IP_PER_MINUTE=60

# Agent
AGENT_MAX_ITERATIONS=10
SESSION_HISTORY_LIMIT=20
ANSWER_HISTORY_MESSAGES=6
ANSWER_HISTORY_MAX_CHARS=800
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=0.8
LLM_CONCURRENCY=8
DB_CONCURRENCY=8
CONCURRENCY_ACQUIRE_TIMEOUT=30

# 语义问答缓存（可选；需本机 Redis）
SEMANTIC_CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_ENTRIES=500
REDIS_RECONNECT_INTERVAL_SECONDS=30

# 认证 / CORS
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=24
# 开发可用 *；生产必须改为具体 Origin，如 https://agent.example.com
CORS_ORIGINS=*
# 启动时写入演示账号；生产请设 false
ENSURE_DEMO_USERS=true
METRICS_ENABLED=true
