# 复制为 .env.prod 后填写真实值（勿提交 Git）
APP_NAME=傲基智能数据问答 Agent
APP_ENV=production
DEBUG=false

OPENAI_API_KEY=sk-your-dashscope-key
OPENAI_MODEL=qwen-max
OPENAI_ROUTER_MODEL=qwen-turbo
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_EMBEDDING_MODEL=text-embedding-v3

# 指向可从容器访问的 MySQL（服务器内网 IP / 云 RDS；勿写 127.0.0.1）
MYSQL_HOST=172.17.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_DATABASE=au_agent
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_TIMEOUT=30
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=60
MYSQL_MAX_EXECUTION_TIME_MS=15000

CHROMA_PERSIST_DIR=/app/data/chroma
CHROMA_COLLECTION_NAME=au_internal_docs
# 默认 local；若用 docker-compose.chroma.yml / K8s 10-chroma 则改为 http
VECTOR_BACKEND=local
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_SSL=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_IP_PER_MINUTE=60

AGENT_MAX_ITERATIONS=10
SESSION_HISTORY_LIMIT=20
ANSWER_HISTORY_MESSAGES=6
ANSWER_HISTORY_MAX_CHARS=800
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_SECONDS=0.8
LLM_CONCURRENCY=8
DB_CONCURRENCY=8
CONCURRENCY_ACQUIRE_TIMEOUT=30

SEMANTIC_CACHE_ENABLED=true
REDIS_URL=redis://redis:6379/0
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_ENTRIES=500
REDIS_RECONNECT_INTERVAL_SECONDS=30

# 生产必填：强随机 JWT（≥24 字符）与 CORS 白名单（禁止 *）
JWT_SECRET=replace-with-a-long-random-secret-at-least-24-chars
JWT_EXPIRE_HOURS=24
CORS_ORIGINS=http://服务器IP:8080,https://your-domain.example.com
ENSURE_DEMO_USERS=false
METRICS_ENABLED=true
